# ==========================================
# Zero-Trust IDP - Central Configuration
# ==========================================
# Copy this file to .env and fill in your values.
# DO NOT COMMIT your actual .env file.

# ------------------------------------------
# Cloud Provider Credentials (AWS)
# ------------------------------------------
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=me-central-1

# ------------------------------------------
# General Environment Settings
# ------------------------------------------
# Example: dev, staging, prod
ENV=dev

# Project naming and routing
PROJECT_NAME=ztidp
DOMAIN_NAME=dev.idp.example.com

# ------------------------------------------
# Infrastructure Parameters (Terraform)
# Note: Variables starting with TF_VAR_ are automatically passed to Terraform.
# ------------------------------------------
TF_VAR_project_name=${PROJECT_NAME}
TF_VAR_environment=${ENV}
TF_VAR_aws_region=${AWS_REGION}
TF_VAR_domain_name=${DOMAIN_NAME}

# Networking & EKS
TF_VAR_vpc_cidr=10.0.0.0/16
TF_VAR_az_count=3
TF_VAR_cluster_version=1.29

# Component Feature Toggles
TF_VAR_enable_backstage=true
TF_VAR_enable_keycloak=true
TF_VAR_enable_istio=true
TF_VAR_enable_gatekeeper=true
TF_VAR_enable_tekton=true
TF_VAR_enable_kubecost=true
TF_VAR_enable_cert_manager=true
TF_VAR_enable_spire=false
TF_VAR_enable_falco=false
TF_VAR_enable_cloudfront_techdocs=false

# Component Specific Settings
TF_VAR_backstage_image_tag=1.22.0
TF_VAR_backstage_replicas=2
TF_VAR_keycloak_realm_name=platform-engineering
TF_VAR_budget_threshold_usd=100

# Teams Configuration (JSON format for Terraform variable)
# Example: '[{"name":"team-backend","cost_center":"CC-BACKEND-001","owners":["backend-lead@example.com"]}]'
TF_VAR_teams='[{"name":"team-backend","cost_center":"CC-BACKEND-001","owners":["backend-lead@example.com"]},{"name":"team-frontend","cost_center":"CC-FRONTEND-002","owners":["frontend-lead@example.com"]},{"name":"team-data","cost_center":"CC-DATA-003","owners":["data-lead@example.com"]},{"name":"team-sre","cost_center":"CC-SRE-004","owners":["sre-lead@example.com"]}]'
